# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL async connection URL (used by SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://taxflow:taxflow_password@db:5432/taxflow

# For local development without Docker:
# DATABASE_URL=postgresql+asyncpg://taxflow:taxflow_password@localhost:5432/taxflow

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Get these from https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ─── AI / OpenRouter ──────────────────────────────────────────────────────────
# Get your key from https://openrouter.ai/keys
# Used for: receipt OCR (qwen/qwen2.5-vl-72b-instruct) + AI chat (llama-3.3-70b)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_NAME=TaxFlow AI
DEFAULT_CURRENCY=INR

# ─── Docker / Frontend ────────────────────────────────────────────────────────
# Set this if using Docker Compose, so frontend knows where backend is
VITE_API_BASE_URL=http://localhost:8000

# ─── PostgreSQL (Docker Compose only) ────────────────────────────────────────
POSTGRES_DB=taxflow
POSTGRES_USER=taxflow
POSTGRES_PASSWORD=taxflow_password
POSTGRES_PORT=5432
BACKEND_PORT=8000
